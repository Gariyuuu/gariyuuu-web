# Public chat demo - server-side only, rate-limited key
AI_PLATFORM_BASE_URL=https://api.gariyuuu.com/v1
AI_PLATFORM_DEMO_API_KEY=

# Usage dashboard - talks to the admin-only aggregate usage endpoint
AI_PLATFORM_ADMIN_URL=https://api.gariyuuu.com
AI_PLATFORM_ADMIN_SECRET=

# Dashboard access gate - email must be in the comma-separated allowlist AND
# match the password
DASHBOARD_PASSWORD=
DASHBOARD_ALLOWED_EMAILS=
DASHBOARD_SESSION_SECRET=
